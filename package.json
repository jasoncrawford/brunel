{
  "name": "brunel",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "brunel": "bin/brunel.cjs"
  },
  "scripts": {
    "start": "tsx src/foreman.ts",
    "dev": "tsx watch src/foreman.ts",
    "repl": "tsx src/repl.ts",
    "worker": "tsx src/repl.ts --worker-mode",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "tsx tests/smoke.ts",
    "lint": "eslint src",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.76",
    "@octokit/webhooks": "^13.0.0",
    "dotenv": "^16.0.0",
    "tsx": "^4.0.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^10.0.3",
    "typescript": "^5.0.0",
    "vitest": "^4.1.0"
  }
}
