{
  "name": "brunel",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "brunel": "bin/brunel.cjs"
  },
  "scripts": {
    "build": "cd frontend && npm install && npm run build",
    "start": "tsx src/foreman/index.ts",
    "dev": "tsx watch src/foreman/index.ts",
    "repl": "tsx src/agent/index.ts",
    "worker": "tsx src/agent/index.ts --worker-mode",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "tsx tests/smoke.ts",
    "test:browser": "playwright test",
    "lint": "eslint src",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.119",
    "@hono/node-server": "^1.19.13",
    "@octokit/webhooks": "^13.0.0",
    "@supabase/supabase-js": "^2.99.3",
    "cosmiconfig": "^9.0.1",
    "dotenv": "^16.0.0",
    "hono": "^4.12.14",
    "tsx": "^4.0.0",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.57.1",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^10.0.3",
    "typescript": "^5.0.0",
    "vitest": "^4.1.0"
  }
}
